<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.example.mapper.ScenicMapper">
    <resultMap id="ScenicResultMap" type="org.example.domain.scenic.Scenic">
        <!-- 主表 scenic 字段映射 -->
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="address" property="address"/>
        <result column="area_code" property="areaCode"/>
        <result column="longitude" property="longitude"/>
        <result column="latitude" property="latitude"/>
        <result column="scenic_desc" property="scenicDesc"/>
        <result column="open_time_desc" property="openTimeDesc"/>
        <result column="rating" property="rating"/>
        <result column="hot_value" property="hotValue"/>
        <result column="need_ticket" property="needTicket"/>
        <result column="price" property="price"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="is_delete" property="isDelete"/>

        <!-- 关联图片列表：只映射 id 和 path -->
        <collection property="scenicImgList" ofType="org.example.domain.SystemFile">
            <id column="file_id" property="id"/>
            <result column="path" property="path"/>
        </collection>
    </resultMap>

    <select id="selectScenicById" resultMap="ScenicResultMap">
        SELECT
            s.*,
            sf.id AS file_id,
            sf.path
        FROM scenic s
                 LEFT JOIN scenic_img si ON s.id = si.as_id AND si.is_delete = 0
                 LEFT JOIN system_file sf ON si.file_id = sf.id AND sf.is_delete = 0
        WHERE s.id = #{id}
          AND s.is_delete = 0
    </select>
</mapper>